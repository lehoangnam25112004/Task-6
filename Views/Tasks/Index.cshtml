@model ConstructionProjectManagement.ViewModels.TaskListViewModel
@using ConstructionProjectManagement.Models
@using TaskStatusModel = ConstructionProjectManagement.Models.TaskStatus
@{
    ViewData["Title"] = "Quản lý công việc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Quản lý công việc</h1>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create">Tạo công việc</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label asp-for="ProjectId" class="form-label">Dự án</label>
        <select asp-for="ProjectId" class="form-select"><option value="">Tất cả dự án</option>
            @foreach (var project in Model.Projects) { <option value="@project.Id">@project.ProjectCode - @project.Name</option> }
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatusModel>()" class="form-select"><option value="">Tất cả trạng thái</option></select>
    </div>
    <div class="col-md-2">
        <label asp-for="Priority" class="form-label">Ưu tiên</label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="form-select"><option value="">Tất cả mức ưu tiên</option></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Keyword" class="form-label">Từ khóa</label>
        <input asp-for="Keyword" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary">Tìm kiếm</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Công việc</th>
                    <th>Dự án</th>
                    <th>WBS</th>
                    <th>Ưu tiên</th>
                    <th>Hạn</th>
                    <th>Trạng thái</th>
                    <th>Hoàn thành</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var task in Model.Tasks)
            {
                <tr>
                    <td>
                        @task.Title
                        @if (Model.BlockerCommentTaskIds.Contains(task.Id)) { <span class="badge text-bg-danger">Vướng mắc</span> }
                    </td>
                    <td>@task.Project.ProjectCode</td>
                    <td>@task.WorkItem?.WbsCode</td>
                    <td>@task.Priority.DisplayName()</td>
                    <td>@task.PlannedEndDate.ToString("dd/MM/yyyy")</td>
                    <td>@task.Status.DisplayName()</td>
                    <td>@task.PercentComplete.ToString("0.##")%</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@task.Id">Chi tiết</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
