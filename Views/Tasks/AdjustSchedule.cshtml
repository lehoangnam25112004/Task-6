@model ConstructionProjectManagement.ViewModels.TaskScheduleViewModel
@{
    ViewData["Title"] = "Điều chỉnh kế hoạch";
}

<h1 class="h3 mb-3">Điều chỉnh kế hoạch: @ViewData["TaskTitle"]</h1>
<form asp-action="AdjustSchedule" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ConcurrencyStamp" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="PlannedStartDate" class="form-label"></label>
        <input asp-for="PlannedStartDate" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PlannedEndDate" class="form-label"></label>
        <input asp-for="PlannedEndDate" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" maxlength="500"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu kế hoạch</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
